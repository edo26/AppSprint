# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth v5 Secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here

# Google Apps Script Web App URL
# Deploy your Gas script and paste the URL here
NEXT_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Admin emails (comma-separated)
# Users with these emails will have access to /admin
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com,another@yourdomain.com

# App URL (used for NextAuth in production)
NEXTAUTH_URL=http://localhost:3000
